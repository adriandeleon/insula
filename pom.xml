<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.insula</groupId>
    <artifactId>insula</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Insula</name>
    <description>A fast, keyboard-first JavaFX reader for ZIM offline content archives</description>
    <url>https://github.com/adriandeleon/insula</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <javafx.version>26.0.1</javafx.version>
        <javafx.plugin.version>0.0.8</javafx.plugin.version>
        <atlantafx.version>2.1.0</atlantafx.version>
        <xz.version>1.10</xz.version>
        <zstd.version>1.5.7-3</zstd.version>
        <junit.version>5.11.4</junit.version>
        <spotless.version>3.6.0</spotless.version>
        <palantir.version>2.92.0</palantir.version>
        <jlibtorrent.version>2.0.12.9</jlibtorrent.version>
        <!--
          Where the BitTorrent native ends up, and how the loader is told about it.

          The native ships in its own resource-only jar whose automatic module name cannot even be
          derived ("jlibtorrent.linux.x86_64" fails on the trailing "64"), so it can never sit on
          the module path — and the javafx plugin drops it rather than putting it anywhere else.
          It is therefore on NEITHER path at runtime, which is why jlibtorrent's own
          load-from-classpath step could never find it and BitTorrent was dead in the real app on
          every platform while passing every test (surefire runs on the classpath, where it works).

          So the native is unpacked at build time and handed to jlibtorrent's own documented hook,
          -Djlibtorrent.jni.path, which goes straight to System.load(). Blank here so a build with
          no matching OS profile is simply inert rather than broken.
        -->
        <jlibtorrent.native.skip>true</jlibtorrent.native.skip>
        <jlibtorrent.native.artifact></jlibtorrent.native.artifact>
        <jlibtorrent.native.path></jlibtorrent.native.path>
        <jlibtorrent.natives.dir>${project.build.directory}/natives</jlibtorrent.natives.dir>
        <twelvemonkeys.version>3.12.0</twelvemonkeys.version>
        <!-- Overridden per OS below; -Djpackage.type=app-image gives an unpackaged bundle. -->
        <jpackage.type>app-image</jpackage.type>
    </properties>

    <repositories>
        <!--
          jlibtorrent 2.0.12.x is published only to GitHub Releases. Maven Central's newest is
          1.2.0.18 from 2018, whose macOS artifact ships no Apple Silicon native, so the jars are
          vendored here with their checksums recorded in m2-repo/CHECKSUMS.txt.
        -->
        <repository>
            <id>insula-vendored</id>
            <url>file://${project.basedir}/m2-repo</url>
            <releases>
                <enabled>true</enabled>
                <updatePolicy>never</updatePolicy>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <!-- JavaFX's own media stack: plays the on-demand HLS stream without WebKit, which
                 crashes on it (see VideoPlayerPane). -->
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-media</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-web</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.mkpaz</groupId>
            <artifactId>atlantafx-base</artifactId>
            <version>${atlantafx.version}</version>
        </dependency>
        <!-- ZIM cluster decompression: XZ/LZMA2 (older archives) + Zstandard (default since 2021) -->
        <dependency>
            <groupId>org.tukaani</groupId>
            <artifactId>xz</artifactId>
            <version>${xz.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.luben</groupId>
            <artifactId>zstd-jni</artifactId>
            <version>${zstd.version}</version>
        </dependency>
        <!-- BitTorrent (optional transport). The platform-specific native comes from an OS
             profile below, so a build carries only the native it can actually run. -->
        <dependency>
            <groupId>com.frostwire</groupId>
            <artifactId>jlibtorrent</artifactId>
            <version>${jlibtorrent.version}</version>
        </dependency>
        <dependency>
            <!-- Pure-Java WebP reader (BSD-3-Clause). Every modern ZIM stores images as WebP,
                 which JavaFX's WebView cannot decode; see server/WebpTranscoder. -->
            <groupId>com.twelvemonkeys.imageio</groupId>
            <artifactId>imageio-webp</artifactId>
            <version>${twelvemonkeys.version}</version>
        </dependency>
        <dependency>
            <!-- QR code generation for LAN sharing (MIT, a real JPMS module, zero deps). -->
            <groupId>io.nayuki</groupId>
            <artifactId>qrcodegen</artifactId>
            <version>1.8.0</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
          One native per build: bundling all five would add ~20 MB of code the host can never
          execute. A release build runs once per target anyway (JavaFX itself is per-platform).
        -->
        <profile>
            <id>native-linux-x86_64</id>
            <properties>
                <jlibtorrent.native.skip>false</jlibtorrent.native.skip>
                <jlibtorrent.native.artifact>jlibtorrent-linux-x86_64</jlibtorrent.native.artifact>
                <jlibtorrent.native.path>lib/x86_64/libjlibtorrent-${jlibtorrent.version}.so</jlibtorrent.native.path>
            </properties>
            <activation>
                <os><family>unix</family><name>linux</name><arch>amd64</arch></os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>com.frostwire</groupId>
                    <artifactId>jlibtorrent-linux-x86_64</artifactId>
                    <version>${jlibtorrent.version}</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>native-linux-arm64</id>
            <properties>
                <jlibtorrent.native.skip>false</jlibtorrent.native.skip>
                <jlibtorrent.native.artifact>jlibtorrent-linux-arm64</jlibtorrent.native.artifact>
                <jlibtorrent.native.path>lib/arm64/libjlibtorrent-${jlibtorrent.version}.so</jlibtorrent.native.path>
            </properties>
            <activation>
                <os><family>unix</family><name>linux</name><arch>aarch64</arch></os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>com.frostwire</groupId>
                    <artifactId>jlibtorrent-linux-arm64</artifactId>
                    <version>${jlibtorrent.version}</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>native-macos-x86_64</id>
            <properties>
                <jlibtorrent.native.skip>false</jlibtorrent.native.skip>
                <jlibtorrent.native.artifact>jlibtorrent-macosx-x86_64</jlibtorrent.native.artifact>
                <jlibtorrent.native.path>lib/x86_64/libjlibtorrent.x86_64-${jlibtorrent.version}.dylib</jlibtorrent.native.path>
            </properties>
            <activation>
                <os><family>mac</family><arch>x86_64</arch></os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>com.frostwire</groupId>
                    <artifactId>jlibtorrent-macosx-x86_64</artifactId>
                    <version>${jlibtorrent.version}</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>native-macos-arm64</id>
            <properties>
                <jlibtorrent.native.skip>false</jlibtorrent.native.skip>
                <jlibtorrent.native.artifact>jlibtorrent-macosx-arm64</jlibtorrent.native.artifact>
                <jlibtorrent.native.path>lib/arm64/libjlibtorrent.arm64-${jlibtorrent.version}.dylib</jlibtorrent.native.path>
            </properties>
            <activation>
                <os><family>mac</family><arch>aarch64</arch></os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>com.frostwire</groupId>
                    <artifactId>jlibtorrent-macosx-arm64</artifactId>
                    <version>${jlibtorrent.version}</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>native-windows</id>
            <properties>
                <jlibtorrent.native.skip>false</jlibtorrent.native.skip>
                <jlibtorrent.native.artifact>jlibtorrent-windows</jlibtorrent.native.artifact>
                <jlibtorrent.native.path>lib/x86_64/jlibtorrent-${jlibtorrent.version}.dll</jlibtorrent.native.path>
            </properties>
            <activation>
                <os><family>windows</family></os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>com.frostwire</groupId>
                    <artifactId>jlibtorrent-windows</artifactId>
                    <version>${jlibtorrent.version}</version>
                </dependency>
            </dependencies>
        </profile>
        <!--
            Native installers. jlink cannot link automatic modules, and several dependencies are
            exactly that (the TwelveMonkeys WebP stack, jlibtorrent), so moditect gives each a real
            module descriptor first. jpackage then jlinks a runtime containing only what is
            reachable and wraps it in the host OS's installer format — there is no cross-building,
            so each OS builds its own.
        -->
        <profile>
            <id>dist</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.moditect</groupId>
                        <artifactId>moditect-maven-plugin</artifactId>
                        <version>1.2.2.Final</version>
                        <executions>
                            <execution>
                                <id>add-module-infos</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>add-module-info</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/modules</outputDirectory>
                                    <overwriteExistingFiles>true</overwriteExistingFiles>
                                    <modules>
                                        <module>
                                            <artifact>
                                                <groupId>com.twelvemonkeys.common</groupId>
                                                <artifactId>common-lang</artifactId>
                                                <version>${twelvemonkeys.version}</version>
                                            </artifact>
                                            <moduleInfo>
                                                <name>com.twelvemonkeys.common.lang</name>
                                            </moduleInfo>
                                        </module>
                                        <module>
                                            <artifact>
                                                <groupId>com.twelvemonkeys.common</groupId>
                                                <artifactId>common-io</artifactId>
                                                <version>${twelvemonkeys.version}</version>
                                            </artifact>
                                            <moduleInfo>
                                                <name>com.twelvemonkeys.common.io</name>
                                            </moduleInfo>
                                        </module>
                                        <module>
                                            <artifact>
                                                <groupId>com.twelvemonkeys.common</groupId>
                                                <artifactId>common-image</artifactId>
                                                <version>${twelvemonkeys.version}</version>
                                            </artifact>
                                            <moduleInfo>
                                                <name>com.twelvemonkeys.common.image</name>
                                            </moduleInfo>
                                        </module>
                                        <module>
                                            <artifact>
                                                <groupId>com.twelvemonkeys.imageio</groupId>
                                                <artifactId>imageio-core</artifactId>
                                                <version>${twelvemonkeys.version}</version>
                                            </artifact>
                                            <moduleInfo>
                                                <name>com.twelvemonkeys.imageio.core</name>
                                            </moduleInfo>
                                        </module>
                                        <module>
                                            <artifact>
                                                <groupId>com.twelvemonkeys.imageio</groupId>
                                                <artifactId>imageio-metadata</artifactId>
                                                <version>${twelvemonkeys.version}</version>
                                            </artifact>
                                            <moduleInfo>
                                                <name>com.twelvemonkeys.imageio.metadata</name>
                                            </moduleInfo>
                                        </module>
                                        <module>
                                            <artifact>
                                                <groupId>com.twelvemonkeys.imageio</groupId>
                                                <artifactId>imageio-webp</artifactId>
                                                <version>${twelvemonkeys.version}</version>
                                            </artifact>
                                            <moduleInfo>
                                                <name>com.twelvemonkeys.imageio.webp</name>
                                                <!-- The reader is found through ImageIO's service
                                                     loader, so the provides clause is what makes
                                                     WebP work at all in a linked image. -->
                                                <addServiceUses>true</addServiceUses>
                                            </moduleInfo>
                                        </module>
                                    </modules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <!-- Stages exactly the modular jars the image needs. The classifier-less
                             javafx jars are empty aggregators and the jlibtorrent pair cannot be
                             linked (see module-info), so both are excluded. -->
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>stage-modules</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/dist-modules</outputDirectory>
                                    <includeScope>runtime</includeScope>
                                    <excludeArtifactIds>jlibtorrent,jlibtorrent-linux-x86_64,jlibtorrent-macosx-x86_64,jlibtorrent-macosx-arm64,jlibtorrent-windows-x86_64,common-lang,common-io,common-image,imageio-core,imageio-metadata,imageio-webp</excludeArtifactIds>
                                    <excludeClassifiers></excludeClassifiers>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>package-native</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${project.basedir}/scripts/package.sh</executable>
                                    <arguments>
                                        <argument>${project.build.directory}</argument>
                                        <argument>${project.version}</argument>
                                        <argument>${jpackage.type}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- The installer format is the host's; jpackage cannot cross-build, so each OS makes
             its own. Override with -Djpackage.type=app-image for an unpackaged bundle. -->
        <profile>
            <id>os-linux</id>
            <activation><os><family>unix</family><name>linux</name></os></activation>
            <properties><jpackage.type>deb</jpackage.type></properties>
        </profile>
        <profile>
            <id>os-mac</id>
            <activation><os><family>mac</family></os></activation>
            <properties><jpackage.type>dmg</jpackage.type></properties>
        </profile>
        <profile>
            <id>os-windows</id>
            <activation><os><family>windows</family></os></activation>
            <properties><jpackage.type>msi</jpackage.type></properties>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <!-- Tests run on the classpath (unnamed module): plain unit tests, no toolkit. -->
                    <useModulePath>false</useModulePath>
                    <!-- zstd-jni loads its bundled native library -->
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                    <systemPropertyVariables>
                        <!-- JavaFX 26's built-in Headless Glass platform: UI tests need no display. -->
                        <glass.platform>Headless</glass.platform>
                        <prism.order>sw</prism.order>
                        <!-- Quiets stack traces from tests that deliberately drive failure paths. -->
                        <java.util.logging.config.file>${project.basedir}/src/test/resources/logging.properties</java.util.logging.config.file>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <!--
                  Unpacks the BitTorrent native so jlibtorrent's -Djlibtorrent.jni.path hook has
                  a real file to System.load(). Skipped when no OS profile matched, so an
                  unrecognised host builds and runs with BitTorrent simply absent.
                -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>unpack-torrent-native</id>
                        <phase>generate-resources</phase>
                        <goals><goal>unpack</goal></goals>
                        <configuration>
                            <skip>${jlibtorrent.native.skip}</skip>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.frostwire</groupId>
                                    <artifactId>${jlibtorrent.native.artifact}</artifactId>
                                    <version>${jlibtorrent.version}</version>
                                    <outputDirectory>${jlibtorrent.natives.dir}</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>${javafx.plugin.version}</version>
                <configuration>
                    <mainClass>com.insula/com.insula.app.Main</mainClass>
                    <options>
                        <option>--enable-native-access=com.github.luben.zstd_jni</option>
                        <option>-Djlibtorrent.jni.path=${jlibtorrent.natives.dir}/${jlibtorrent.native.path}</option>
                        <!--
                          Where a crash report lands, if one can be written at all. libjlibtorrent
                          replaces the JVM's SIGSEGV and SIGBUS handlers with its own (confirmed
                          under -Xcheck:jni), which is why a BitTorrent crash exits 139 with no
                          hs_err file anywhere. Use scripts/debug-run.sh to preload libjsig and
                          chain HotSpot's handler back in; this line only makes sure that when a
                          report is produced it is somewhere obvious rather than in whatever
                          directory the fork happened to inherit.
                        -->
                        <option>-XX:ErrorFile=${project.basedir}/hs_err_pid%p.log</option>
                    </options>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <includes>
                            <include>src/main/java/**/*.java</include>
                            <include>src/test/java/**/*.java</include>
                        </includes>
                        <removeUnusedImports/>
                        <palantirJavaFormat>
                            <version>${palantir.version}</version>
                        </palantirJavaFormat>
                        <importOrder>
                            <order>java|javax,javafx,,\#</order>
                        </importOrder>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
